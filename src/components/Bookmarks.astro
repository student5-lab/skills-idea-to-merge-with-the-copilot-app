---
// Bookmarks component.
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// runs ONLY in the client-side <script> boundary at the bottom of this file.
// Astro runs that script in the browser, never during the build, so
// browser-only APIs (localStorage) are safe there. The pure logic (URL
// normalisation, slug generation, storage validation, formatting) lives in
// ../lib/bookmarks.ts, which has no side effects and is unit tested without
// a browser.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only.
  //
  // Because this code lives in a client <script>, browser storage APIs are
  // safe to use here without breaking the static build. The pure logic below
  // is imported from ../lib/bookmarks.ts and unit tested separately.
  import {
    STORAGE_KEY,
    normalizeUrl,
    generateSlug,
    parseBookmarks,
    serializeBookmarks,
    formatBookmark,
    type Bookmark,
  } from '../lib/bookmarks.ts';

  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const urlInput = document.getElementById('url') as HTMLInputElement | null;
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAllButton = document.getElementById('clear-all');

  // Treat localStorage as untrusted: parseBookmarks() validates the shape
  // and drops anything malformed instead of ever throwing, so a corrupted
  // or legacy stored value can never flow straight into render/add paths.
  function loadBookmarks(): Bookmark[] {
    let raw: string | null = null;
    try {
      raw = localStorage.getItem(STORAGE_KEY);
    } catch {
      raw = null;
    }
    return parseBookmarks(raw);
  }

  function saveBookmarks(bookmarks: Bookmark[]): void {
    try {
      localStorage.setItem(STORAGE_KEY, serializeBookmarks(bookmarks));
    } catch {
      // Storage may be unavailable (private mode, quota, etc.) — the
      // in-memory list still renders for this page view either way.
    }
  }

  function render(bookmarks: Bookmark[]): void {
    if (!list || !emptyState || !listHeader) return;

    list.innerHTML = '';

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'sep';
      separator.setAttribute('aria-hidden', 'true');
      separator.textContent = ' :: ';

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.type = 'button';
      copyButton.className = 'copy';
      copyButton.textContent = 'Copy';
      copyButton.setAttribute(
        'aria-label',
        `Copy ${formatBookmark(bookmark)} to clipboard`
      );
      copyButton.addEventListener('click', () => {
        navigator.clipboard?.writeText(bookmark.slug).then(
          () => {
            const original = copyButton.textContent;
            copyButton.textContent = 'Copied!';
            setTimeout(() => {
              copyButton.textContent = original;
            }, 1500);
          },
          () => {
            // Clipboard write can fail (permissions, insecure context, etc.);
            // the slug is still visible on the page for manual copying.
          }
        );
      });

      item.append(link, separator, slug, copyButton);
      list.append(item);
    }
  }

  let bookmarks = loadBookmarks();
  render(bookmarks);

  form?.addEventListener('submit', (event) => {
    event.preventDefault(); // keep this — stops the page from reloading

    try {
      const rawUrl = urlInput?.value ?? '';
      const normalized = normalizeUrl(rawUrl);
      if (!normalized) {
        urlInput?.setCustomValidity('Enter a valid URL, e.g. example.com');
        urlInput?.reportValidity();
        return;
      }
      urlInput?.setCustomValidity('');

      const existingSlugs = new Set(bookmarks.map((b) => b.slug));
      const slug = generateSlug(existingSlugs);
      bookmarks = [...bookmarks, { url: normalized, slug }];
      saveBookmarks(bookmarks);
      render(bookmarks);

      form.reset();
      urlInput?.focus();
    } catch {
      // Never let an unexpected error fall back to a native submit/reload —
      // preventDefault() above already guarantees the page won't navigate.
    }
  });

  clearAllButton?.addEventListener('click', () => {
    const confirmed = window.confirm('Remove all saved bookmarks?');
    if (!confirmed) return;
    bookmarks = [];
    saveBookmarks(bookmarks);
    render(bookmarks);
  });
</script>

<style>
  .bookmark .sep {
    color: var(--muted);
    font-family: ui-monospace, 'SF Mono', monospace;
  }
</style>
